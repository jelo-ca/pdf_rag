__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Environment variables
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo

